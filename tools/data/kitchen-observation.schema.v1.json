{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yiguochu.pages.dev/schemas/kitchen-observation.v1.json",
  "title": "一锅出厨房观察记录",
  "description": "单次真实试做的结构化观察契约；来源合同与实际观察必须分列。此 schema 不存放真实观察记录。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "recorded_at", "observer", "recipe", "claim_scope", "ingredients", "liquid", "equipment", "timeline", "process_adherence", "safety_endpoints", "sensory_result", "feedback", "journey_regression", "disposition", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "kitchen-observation.v1"},
    "observation_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "observer": {"$ref": "#/$defs/observer"},
    "recipe": {"$ref": "#/$defs/recipe"},
    "claim_scope": {"$ref": "#/$defs/claimScope"},
    "ingredients": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ingredient"}},
    "liquid": {"$ref": "#/$defs/liquid"},
    "equipment": {"$ref": "#/$defs/equipment"},
    "timeline": {"$ref": "#/$defs/timeline"},
    "process_adherence": {"$ref": "#/$defs/process"},
    "safety_endpoints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/safety"}},
    "sensory_result": {"$ref": "#/$defs/sensory"},
    "feedback": {"$ref": "#/$defs/feedback"},
    "journey_regression": {"$ref": "#/$defs/journey"},
    "disposition": {"$ref": "#/$defs/disposition"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "amount": {"type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": {"value": {"type": "number", "minimum": 0}, "unit": {"$ref": "#/$defs/nonEmpty"}}},
    "observer": {"type": "object", "additionalProperties": false, "required": ["operator_id", "household_id", "role"], "properties": {"operator_id": {"$ref": "#/$defs/nonEmpty"}, "household_id": {"$ref": "#/$defs/nonEmpty"}, "role": {"enum": ["cook", "reviewer"]}}},
    "recipe": {"type": "object", "additionalProperties": false, "required": ["recipe_id", "variant_id", "canonical_name", "catalog_version", "runtime_catalog_ref", "execution_card_ref", "source_status_at_attempt", "formalization_status_at_attempt"], "properties": {"recipe_id": {"$ref": "#/$defs/nonEmpty"}, "variant_id": {"$ref": "#/$defs/nonEmpty"}, "canonical_name": {"$ref": "#/$defs/nonEmpty"}, "catalog_version": {"$ref": "#/$defs/nonEmpty"}, "runtime_catalog_ref": {"$ref": "#/$defs/nonEmpty"}, "execution_card_ref": {"$ref": "#/$defs/nonEmpty"}, "source_status_at_attempt": {"$ref": "#/$defs/nonEmpty"}, "formalization_status_at_attempt": {"$ref": "#/$defs/nonEmpty"}}},
    "claimScope": {"type": "object", "additionalProperties": false, "required": ["servings_claimed", "servings_observed", "supported_batch_only"], "properties": {"servings_claimed": {"type": "number", "minimum": 1}, "servings_observed": {"type": "number", "minimum": 1}, "supported_batch_only": {"const": true}}},
    "ingredient": {"type": "object", "additionalProperties": false, "required": ["canonical_id", "raw_label", "state", "source_amount", "observed_amount", "measurement_method", "deviation_reason", "used", "substitution"], "properties": {"canonical_id": {"$ref": "#/$defs/nonEmpty"}, "raw_label": {"$ref": "#/$defs/nonEmpty"}, "state": {"enum": ["raw", "soaked", "cooked", "canned", "drained", "other"]}, "source_amount": {"$ref": "#/$defs/amount"}, "observed_amount": {"$ref": "#/$defs/amount"}, "measurement_method": {"enum": ["scale", "count", "volume", "waterline"]}, "deviation_reason": {"type": "string"}, "used": {"type": "boolean"}, "substitution": {"type": ["object", "null"]}}},
    "liquid": {"type": "object", "additionalProperties": false, "required": ["source_contract", "observed_added_amount", "observed_retained_liquid", "observed_absorbed_or_remaining", "waterline", "liquid_phase_split", "liquid_deviation"], "properties": {"source_contract": {"type": "object", "required": ["type", "amount", "expression"], "properties": {"type": {"$ref": "#/$defs/nonEmpty"}, "amount": {"$ref": "#/$defs/amount"}, "expression": {"$ref": "#/$defs/nonEmpty"}}}, "observed_added_amount": {"$ref": "#/$defs/amount"}, "observed_retained_liquid": {"$ref": "#/$defs/amount"}, "observed_absorbed_or_remaining": {"$ref": "#/$defs/nonEmpty"}, "waterline": {"type": "object", "required": ["appliance_model", "scale", "mark"], "properties": {"appliance_model": {"$ref": "#/$defs/nonEmpty"}, "scale": {"$ref": "#/$defs/nonEmpty"}, "mark": {"$ref": "#/$defs/nonEmpty"}}}, "liquid_phase_split": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["phase", "amount"], "properties": {"phase": {"$ref": "#/$defs/nonEmpty"}, "amount": {"$ref": "#/$defs/amount"}}}}, "liquid_deviation": {"type": "object", "required": ["occurred", "details"], "properties": {"occurred": {"type": "boolean"}, "details": {"type": "string"}}}}},
    "equipment": {"type": "object", "additionalProperties": false, "required": ["brand", "model", "capacity", "vessel_type", "program", "pressure_or_heat_mode", "accessories", "voltage_or_region_if_relevant", "max_fill_or_waterline_limit"], "properties": {"brand": {"$ref": "#/$defs/nonEmpty"}, "model": {"$ref": "#/$defs/nonEmpty"}, "capacity": {"$ref": "#/$defs/amount"}, "vessel_type": {"$ref": "#/$defs/nonEmpty"}, "program": {"$ref": "#/$defs/nonEmpty"}, "pressure_or_heat_mode": {"$ref": "#/$defs/nonEmpty"}, "accessories": {"type": "array"}, "voltage_or_region_if_relevant": {"$ref": "#/$defs/nonEmpty"}, "max_fill_or_waterline_limit": {"$ref": "#/$defs/nonEmpty"}}},
    "timeline": {"type": "object", "additionalProperties": false, "required": ["prep_started_at", "cook_started_at", "program_elapsed_minutes", "pressure_release_or_jump_at", "rest_minutes", "finish_at", "manual_intervention_at"], "properties": {"prep_started_at": {"type": "string", "format": "date-time"}, "cook_started_at": {"type": "string", "format": "date-time"}, "program_elapsed_minutes": {"type": "number", "minimum": 0}, "pressure_release_or_jump_at": {"type": "string", "format": "date-time"}, "rest_minutes": {"type": "number", "minimum": 0}, "finish_at": {"type": "string", "format": "date-time"}, "manual_intervention_at": {"type": "array"}}},
    "process": {"type": "object", "additionalProperties": false, "required": ["steps"], "properties": {"steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["step", "completed", "observed_at", "deviation", "deviation_reason", "external_vessel_action"], "properties": {"step": {"type": "number", "minimum": 1}, "completed": {"type": "boolean"}, "observed_at": {"type": "string", "format": "date-time"}, "deviation": {"type": "string"}, "deviation_reason": {"type": "string"}, "external_vessel_action": {"type": "string"}}}}}},
    "safety": {"type": "object", "additionalProperties": false, "required": ["ingredient_or_hazard", "required_endpoint", "observed", "result", "evidence_ref"], "properties": {"ingredient_or_hazard": {"$ref": "#/$defs/nonEmpty"}, "required_endpoint": {"type": "object", "required": ["kind", "minimum"], "properties": {"kind": {"$ref": "#/$defs/nonEmpty"}, "minimum": {"type": "number"}}}, "observed": {"type": "object", "required": ["value", "unit", "instrument_id", "location", "measured_at"], "properties": {"value": {"type": "number"}, "unit": {"$ref": "#/$defs/nonEmpty"}, "instrument_id": {"$ref": "#/$defs/nonEmpty"}, "location": {"$ref": "#/$defs/nonEmpty"}, "measured_at": {"type": "string", "format": "date-time"}}}, "result": {"enum": ["pass", "fail", "not_applicable"]}, "evidence_ref": {"$ref": "#/$defs/nonEmpty"}}},
    "sensory": {"type": "object", "additionalProperties": false, "required": ["rice_texture", "protein_texture", "vegetable_texture", "liquid_or_bottom", "taste", "portion_complete", "yield_observed", "photos_or_notes"], "properties": {"rice_texture": {"$ref": "#/$defs/nonEmpty"}, "protein_texture": {"$ref": "#/$defs/nonEmpty"}, "vegetable_texture": {"$ref": "#/$defs/nonEmpty"}, "liquid_or_bottom": {"$ref": "#/$defs/nonEmpty"}, "taste": {"$ref": "#/$defs/nonEmpty"}, "portion_complete": {"type": "boolean"}, "yield_observed": {"type": "object", "required": ["servings", "amount"], "properties": {"servings": {"type": "number", "minimum": 0}, "amount": {"$ref": "#/$defs/amount"}}}, "photos_or_notes": {"$ref": "#/$defs/nonEmpty"}}},
    "feedback": {"type": "object", "additionalProperties": false, "required": ["instruction_clarity", "missing_ingredient_or_tool", "effort_level", "would_repeat", "quote", "photo_refs", "reported_safety_or_discomfort"], "properties": {"instruction_clarity": {"$ref": "#/$defs/nonEmpty"}, "missing_ingredient_or_tool": {"type": "string"}, "effort_level": {"$ref": "#/$defs/nonEmpty"}, "would_repeat": {"type": "boolean"}, "quote": {"$ref": "#/$defs/nonEmpty"}, "photo_refs": {"type": "array"}, "reported_safety_or_discomfort": {"type": "string"}}},
    "journey": {"type": "object", "additionalProperties": false, "required": ["journey_id", "mode", "intent", "servings", "input_items", "dislikes_or_allergens", "expected_plan_status", "actual_plan_status", "used_items", "unused_items_and_reason", "substitution_result", "failure_code", "browser_evidence_ref"], "properties": {"journey_id": {"$ref": "#/$defs/nonEmpty"}, "mode": {"$ref": "#/$defs/nonEmpty"}, "intent": {"$ref": "#/$defs/nonEmpty"}, "servings": {"type": "number", "minimum": 1}, "input_items": {"type": "array"}, "dislikes_or_allergens": {"type": "array"}, "expected_plan_status": {"$ref": "#/$defs/nonEmpty"}, "actual_plan_status": {"$ref": "#/$defs/nonEmpty"}, "used_items": {"type": "array"}, "unused_items_and_reason": {"type": "array"}, "substitution_result": {"type": "object", "required": ["attempted", "status", "details"], "properties": {"attempted": {"type": "boolean"}, "status": {"$ref": "#/$defs/nonEmpty"}, "details": {"type": "string"}}}, "failure_code": {"type": ["string", "null"]}, "browser_evidence_ref": {"$ref": "#/$defs/nonEmpty"}}},
    "disposition": {"type": "object", "additionalProperties": false, "required": ["status", "reviewer_id", "reviewed_at", "approve_for_production", "notes"], "properties": {"status": {"enum": ["pending_review", "repeat_required", "fail_quality", "blocked", "kitchen_observed"]}, "reviewer_id": {"$ref": "#/$defs/nonEmpty"}, "reviewed_at": {"type": ["string", "null"], "format": "date-time"}, "approve_for_production": {"const": false}, "notes": {"type": "string"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "ref"], "properties": {"kind": {"$ref": "#/$defs/nonEmpty"}, "id": {"$ref": "#/$defs/nonEmpty"}, "ref": {"$ref": "#/$defs/nonEmpty"}}}
  }
}
