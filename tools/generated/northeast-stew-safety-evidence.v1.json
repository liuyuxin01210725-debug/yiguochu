  "rules": [
    {
      "rule_id": "pork-ribs-safe-endpoint-v1",
      "branch_id": "pork_ribs",
      "decision_status": "calibration_ready",
      "applies_to_canonical_ids": [
        "pork-ribs"
      ],
      "source_ids": [
        "foodsafety-gov-pork-ribs-2023"
