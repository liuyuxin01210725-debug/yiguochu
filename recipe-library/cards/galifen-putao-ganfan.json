    "summary": "米 1 杯；约 2 人",
    "rice": "米 1 杯",
    "people": "约 2 人"
  },
  "ingredients": [
    "黄油 1 大勺",
    "洋葱 1/2",
    "咖喱粉 1 小勺",
    "米 1 杯",
    "葡萄干 2 大勺",
    "水 2 杯",
    "高汤块 1 小块或盐"
  ],
  "steps_now": [
    "黄油炒洋葱至微黄，下咖喱粉炒 1 分钟。",
    "下米、葡萄干、水和汤块。",
    "盖严，小火约 15 分钟至水干。拨散。"
  ],
